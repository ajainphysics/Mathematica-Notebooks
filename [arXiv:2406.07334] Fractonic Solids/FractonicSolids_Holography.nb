Cell["Find the dispersion relations", "Text",
 CellChangeTimes->{{3.941280806193054*^9, 
  3.941280813924663*^9}},ExpressionUUID->"0551a9a5-2e46-41ea-960c-\
af95cf54b624"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"d", "=", "3"}], ";", 
  RowBox[{"z0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"dispsQ0", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"k", ",", 
       RowBox[{
        RowBox[{"\[ImaginaryI]disp", "[", 
         RowBox[{"k", ",", "d", ",", "z0"}], "]"}], "\[LeftDoubleBracket]", 
        "1", "\[RightDoubleBracket]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"k", ",", "0", ",", "0.5", ",", "0.03"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fit", "[", "k_", "]"}], "=", 
  RowBox[{"Fit", "[", 
   RowBox[{"dispsQ0", ",", 
    RowBox[{"{", 
     RowBox[{
      SuperscriptBox["k", "2"], ",", 
      SuperscriptBox["k", "4"], ",", 
      SuperscriptBox["k", "6"], ",", 
      SuperscriptBox["k", "8"]}], "}"}], ",", "k"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"ListPlot", "[", "dispsQ0", "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"fit", "[", "k", "]"}], ",", 
        RowBox[{
         FractionBox["z0", 
          RowBox[{"d", "-", "1"}]], 
         SuperscriptBox["k", "2"]}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"k", ",", "0", ",", "1"}], "}"}]}], "]"}]}], "}"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{"ClearAll", "[", 
  RowBox[{"d", ",", "z0"}], "]"}]}], "Input",
 CellChangeTimes->{{3.941280830422777*^9, 3.941280856799693*^9}, 
   3.941280937720481*^9, {3.9412809824238367`*^9, 3.941281033873171*^9}, {
