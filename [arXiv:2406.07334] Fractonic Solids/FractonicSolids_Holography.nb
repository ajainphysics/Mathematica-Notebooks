Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fVal", "[", 
    RowBox[{"z_", ",", "d_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["z", 
      RowBox[{"d", "+", "1"}]], 
     SuperscriptBox["z0", 
      RowBox[{"d", "+", "1"}]]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DE1", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "z_", ",", "d_", ",", "z0_", ",",
      "\[Lambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["z", 
          RowBox[{"d", "-", "2"}]]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "z"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", 
            RowBox[{"d", "-", "2"}]], 
           RowBox[{"f", "[", 
            RowBox[{"z", ",", "d", ",", "z0"}], "]"}], 
           RowBox[{
            RowBox[{"a", "'"}], "[", "z", "]"}]}], ")"}]}]}], "+", 
       RowBox[{"\[ImaginaryI]\[Omega]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "'"}], "[", "z", "]"}], "+", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["z", 
             RowBox[{"d", "-", "2"}]]], 
           RowBox[{
            SubscriptBox["\[PartialD]", "z"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["z", 
               RowBox[{"d", "-", "2"}]], 
              RowBox[{"a", "[", "z", "]"}]}], ")"}]}]}]}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["k", "2"], 
        RowBox[{"a", "[", "z", "]"}]}], "+", 
       RowBox[{"\[Lambda]", " ", 
        SuperscriptBox["k", "2"], 
        RowBox[{"b", "[", "z", "]"}]}]}], ")"}], "/.", 
     RowBox[{"f", "->", "fVal"}]}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DE2", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "z_", ",", "d_", ",", "z0_", ",",
      "\[Lambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["z", 
          RowBox[{"d", "-", "2"}]]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "z"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", 
            RowBox[{"d", "-", "2"}]], 
           RowBox[{"f", "[", 
            RowBox[{"z", ",", "d", ",", "z0"}], "]"}], 
           RowBox[{
            RowBox[{"b", "'"}], "[", "z", "]"}]}], ")"}]}]}], "+", 
       RowBox[{"\[ImaginaryI]\[Omega]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"b", "'"}], "[", "z", "]"}], "+", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["z", 
             RowBox[{"d", "-", "2"}]]], 
           RowBox[{
            SubscriptBox["\[PartialD]", "z"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["z", 
               RowBox[{"d", "-", "2"}]], 
              RowBox[{"b", "[", "z", "]"}]}], ")"}]}]}]}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["k", "2"], 
        RowBox[{"b", "[", "z", "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"b", "[", "z", "]"}]}], "-", 
         RowBox[{"a", "[", "z", "]"}]}], ")"}]}], ")"}], "/.", 
     RowBox[{"f", "->", "fVal"}]}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.94119451207531*^9, 3.941194542346142*^9}, {
  3.941195009936081*^9, 3.941195135219234*^9}, {3.941195213430114*^9, 
  3.941195230343963*^9}, {3.94119542385813*^9, 3.94119543059512*^9}, {
