Cell["Asymptotic expansions", "Text",
 CellChangeTimes->{{3.9412807421611567`*^9, 
  3.941280748256846*^9}},ExpressionUUID->"f0a613c3-cae9-440e-96b7-\
aa384f7eb0f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"expansion", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aAnsUV", "[", "z_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aUV", "[", "n", "]"}], 
      SuperscriptBox["z", "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bAnsUV", "[", "z_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bUV", "[", "n", "]"}], 
      SuperscriptBox["z", "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aAnsIR", "[", 
    RowBox[{"z_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aIR", "[", "n", "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z0", "-", "z"}], ")"}], "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bAnsIR", "[", 
    RowBox[{"z_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bIR", "[", "n", "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z0", "-", "z"}], ")"}], "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCUV", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "bx_", ",", "d_", ",", "z0_", ",",
      "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"DE1", "[", 
            RowBox[{
            "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0", 
             ",", "\[Lambda]"}], "]"}], ",", 
           RowBox[{"DE2", "[", 
            RowBox[{
            "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0", 
             ",", "\[Lambda]"}], "]"}]}], "}"}]}], "/.", 
        RowBox[{"a", "->", "aAnsUV"}]}], "/.", 
       RowBox[{"b", "->", "bAnsUV"}]}], "//", 
      RowBox[{
       RowBox[{"#", "+", 
        SuperscriptBox[
         RowBox[{"O", "[", "z", "]"}], "expansion"]}], "&"}]}], "//", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"#", "==", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"aUV", "[", "n", "]"}], ",", 
             RowBox[{"bUV", "[", "n", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "expansion"}], "}"}]}], "]"}], "//", 
         "Flatten"}]}], "]"}], "&"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"aAnsUV", "[", "z", "]"}], "//", "Evaluate"}]}], 
            "]"}]}], ",", 
          RowBox[{"b", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"bAnsUV", "[", "z", "]"}], "//", "Evaluate"}]}], 
            "]"}]}]}], "}"}], "/.", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "/.", 
       RowBox[{
        RowBox[{"aUV", "[", "0", "]"}], "->", "1"}]}], "/.", 
      RowBox[{
       RowBox[{"bUV", "[", "0", "]"}], "->", "bx"}]}], "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCIR", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "a0_", ",", "b0_", ",", "d_", ",",
      "z0_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"DE1", "[", 
             RowBox[{
             "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0",
               ",", "\[Lambda]"}], "]"}], ",", 
            RowBox[{"DE2", "[", 
             RowBox[{
             "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0",
               ",", "\[Lambda]"}], "]"}]}], "}"}], "/.", 
          RowBox[{"a", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{"aAnsIR", "[", 
              RowBox[{"z", ",", "z0"}], "]"}]}], "]"}]}]}], "/.", 
         RowBox[{"b", "->", 
          RowBox[{"Function", "[", 
           RowBox[{"z", ",", 
            RowBox[{"bAnsIR", "[", 
             RowBox[{"z", ",", "z0"}], "]"}]}], "]"}]}]}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"z0", "-", "\[Delta]z"}]}]}], "//", 
       RowBox[{
        RowBox[{"#", "+", 
         SuperscriptBox[
          RowBox[{"O", "[", "\[Delta]z", "]"}], "expansion"]}], "&"}]}], "//", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"#", "==", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"aIR", "[", "n", "]"}], ",", 
              RowBox[{"bIR", "[", "n", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "1", ",", "expansion"}], "}"}]}], "]"}], "//", 
          "Flatten"}]}], "]"}], "&"}]}], "//", "Simplify"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"aAnsIR", "[", 
               RowBox[{"z", ",", "z0"}], "]"}], "//", "Evaluate"}]}], "]"}]}],
           ",", 
          RowBox[{"b", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"bAnsIR", "[", 
               RowBox[{"z", ",", "z0"}], "]"}], "//", "Evaluate"}]}], 
            "]"}]}]}], "}"}], "/.", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "/.", 
       RowBox[{
        RowBox[{"aIR", "[", "0", "]"}], "->", "a0"}]}], "/.", 
      RowBox[{
       RowBox[{"bIR", "[", "0", "]"}], "->", "b0"}]}], "&"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.941197766534936*^9, 3.941197782876367*^9}, {
   3.941197823503355*^9, 3.941197886467741*^9}, {3.941197931899485*^9, 
   3.94119793220431*^9}, 3.941198133263688*^9, {3.941198167621113*^9, 
   3.941198339231649*^9}, {3.9411983694836197`*^9, 3.941198398892955*^9}, {
   3.941198866705759*^9, 3.941198902025858*^9}, 3.941199262754994*^9, 
   3.941199341773526*^9, {3.941199633649605*^9, 3.941199641823968*^9}, {
   3.941204010989293*^9, 3.941204017681391*^9}, {3.941204053482757*^9, 
   3.941204053761302*^9}, {3.941278642394052*^9, 3.941278642970147*^9}, 
   3.941281510275764*^9, {3.941281553815138*^9, 3.941281614387115*^9}, {
   3.94128164894343*^9, 3.9412817943587713`*^9}, 3.941805808655211*^9},
