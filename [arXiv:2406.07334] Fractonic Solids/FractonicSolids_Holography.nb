Notebook[{
Cell["\<\
This is a supplementary Mathematica notebook for the paper \
\[OpenCurlyDoubleQuote]Fractonic solids\[CloseCurlyDoubleQuote] available at \
https://arxiv.org/abs/2406.07334.
Here we compute the quasi-normal modes of a charged black brane in the \
holographic model for fractonic solids.\
\>", "Text",
 CellChangeTimes->{{3.9411961207684183`*^9, 3.941196121611578*^9}, {
  3.983259101906479*^9, 
  3.983259142894266*^9}},ExpressionUUID->"8c158e78-4a42-4c1d-b1fd-\
140d07a02d0e"],

Cell[CellGroupData[{

Cell["Ordinary charged holography", "Chapter",
 CellChangeTimes->{{3.941195084067369*^9, 3.941195084356594*^9}, {
  3.941278339519018*^9, 
  3.941278345912846*^9}},ExpressionUUID->"b3da725f-634d-489e-8d07-\
9e020dd940b9"],

Cell["Start with the differential equation", "Text",
 CellChangeTimes->{{3.94128072865935*^9, 
  3.941280734525185*^9}},ExpressionUUID->"e5c88cb3-b879-4acb-9f97-\
f3a87502aa09"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fVal", "[", 
    RowBox[{"z_", ",", "d_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["z", 
      RowBox[{"d", "+", "1"}]], 
     SuperscriptBox["z0", 
      RowBox[{"d", "+", "1"}]]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DE", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "z_", ",", "d_", ",", "z0_"}], 
    "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["z", 
          RowBox[{"d", "-", "2"}]]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "z"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", 
            RowBox[{"d", "-", "2"}]], 
           RowBox[{"f", "[", 
            RowBox[{"z", ",", "d", ",", "z0"}], "]"}], 
           RowBox[{
            RowBox[{"a", "'"}], "[", "z", "]"}]}], ")"}]}]}], "+", 
       RowBox[{"\[ImaginaryI]\[Omega]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "'"}], "[", "z", "]"}], "+", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["z", 
             RowBox[{"d", "-", "2"}]]], 
           RowBox[{
            SubscriptBox["\[PartialD]", "z"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["z", 
               RowBox[{"d", "-", "2"}]], 
              RowBox[{"a", "[", "z", "]"}]}], ")"}]}]}]}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["k", "2"], 
        RowBox[{"a", "[", "z", "]"}]}]}], ")"}], "/.", 
     RowBox[{"f", "->", "fVal"}]}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.94119451207531*^9, 3.941194542346142*^9}, {
  3.941195009936081*^9, 3.941195135219234*^9}, {3.941195213430114*^9, 
  3.941195230343963*^9}, {3.94119542385813*^9, 3.94119543059512*^9}, {
  3.941195553694321*^9, 3.941195559035137*^9}, {3.941196389982085*^9, 
  3.941196397765764*^9}, {3.9412783525825253`*^9, 3.941278416602091*^9}, {
  3.9412784575492163`*^9, 3.9412785154368153`*^9}, {3.94127856572572*^9, 
  3.941278594457577*^9}, {3.9412813603230457`*^9, 3.9412813626073747`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"54554b8a-6635-478b-8d49-5f3cb5e4ec7f"],

Cell["Asymptotic expansions", "Text",
 CellChangeTimes->{{3.9412807421611557`*^9, 
  3.941280748256846*^9}},ExpressionUUID->"351b5f0c-e2b2-4715-bd51-\
def55bf94add"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"expansion", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aAnsUV", "[", "z_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aUV", "[", "n", "]"}], 
      SuperscriptBox["z", "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aAnsIR", "[", 
    RowBox[{"z_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aIR", "[", "n", "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z0", "-", "z"}], ")"}], "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCUV", "[", 
    RowBox[{"\[ImaginaryI]\[Omega]_", ",", "k_", ",", "d_", ",", "z0_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z", " ", 
         RowBox[{"DE", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0"}], 
          "]"}]}], "/.", 
        RowBox[{"a", "->", "aAnsUV"}]}], "//", 
       RowBox[{
        RowBox[{"#", "+", 
         SuperscriptBox[
          RowBox[{"O", "[", "z", "]"}], "expansion"]}], "&"}]}], "//", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"#", "==", "0"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"aUV", "[", "n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "expansion"}], "}"}]}], "]"}]}], 
        "]"}], "&"}]}], "//", "Simplify"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"a", "->", 
          RowBox[{"Function", "[", 
           RowBox[{"z", ",", 
            RowBox[{
             RowBox[{"aAnsUV", "[", "z", "]"}], "//", "Evaluate"}]}], "]"}]}],
          "}"}], "/.", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "/.", 
       RowBox[{
        RowBox[{"aUV", "[", "0", "]"}], "->", "1"}]}], "/.", 
      RowBox[{
       RowBox[{"aUV", "[", 
        RowBox[{"3", "-", "d"}], "]"}], "->", "0"}]}], "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCIR", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "a0_", ",", "d_", ",", "z0_"}], 
    "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"DE", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0"}], 
          "]"}], "/.", 
         RowBox[{"a", "->", 
          RowBox[{"Function", "[", 
           RowBox[{"z", ",", 
            RowBox[{"aAnsIR", "[", 
             RowBox[{"z", ",", "z0"}], "]"}]}], "]"}]}]}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"z0", "+", "\[Delta]z"}]}]}], "//", 
       RowBox[{
        RowBox[{"#", "+", 
         SuperscriptBox[
          RowBox[{"O", "[", "\[Delta]z", "]"}], "expansion"]}], "&"}]}], "//", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"#", "==", "0"}], ",", 
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"aIR", "[", "n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "expansion"}], "}"}]}], "]"}]}], 
        "]"}], "&"}]}], "//", "Simplify"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"a", "->", 
         RowBox[{"Function", "[", 
          RowBox[{"z", ",", 
           RowBox[{
            RowBox[{"aAnsIR", "[", 
             RowBox[{"z", ",", "z0"}], "]"}], "//", "Evaluate"}]}], "]"}]}], 
        "}"}], "/.", 
       RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}], 
      "/.", 
      RowBox[{
       RowBox[{"aIR", "[", "0", "]"}], "->", "a0"}]}], "&"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.94112321580534*^9, 3.941123530343799*^9}, {
   3.941123560433904*^9, 3.9411235917337*^9}, {3.94112379226169*^9, 
   3.941123820749314*^9}, {3.941124139993456*^9, 3.941124197301538*^9}, {
   3.941124230549484*^9, 3.941124230864052*^9}, {3.941195254378586*^9, 
   3.941195336553856*^9}, {3.941195434348811*^9, 3.941195436835269*^9}, {
   3.9411964098300047`*^9, 3.941196421690669*^9}, {3.941196564336108*^9, 
   3.941196571247712*^9}, {3.941197327783856*^9, 3.941197341102244*^9}, {
   3.941197377528926*^9, 3.941197468014842*^9}, {3.941278631253337*^9, 
   3.941278710392054*^9}, {3.941278750892663*^9, 3.941278794813878*^9}, {
   3.9412788280655317`*^9, 3.941278915328393*^9}, {3.94127895045681*^9, 
   3.94127895059968*^9}, {3.94127919965756*^9, 3.941279200152755*^9}, {
   3.9412797972212477`*^9, 3.941279831980961*^9}, {3.941279951933165*^9, 
   3.941280067472663*^9}, {3.941280189747341*^9, 3.941280191409205*^9}, {
   3.941280316237368*^9, 3.941280395686226*^9}, 3.94128073682117*^9, {
   3.941281528556126*^9, 3.941281531150371*^9}},
 CellLabel->"In[3]:=",ExpressionUUID->"530f6ddc-39eb-44f9-bc22-cdf638492e3c"],

Cell["Numerical solvers from the boundary and the horizon", "Text",
 CellChangeTimes->{{3.941280754884863*^9, 
  3.9412807835151253`*^9}},ExpressionUUID->"d58633c7-f90e-4592-bf34-\
9ed6d1000fef"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zMid", "=", 
   RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SolUV", "[", 
   RowBox[{"\[ImaginaryI]\[Omega]_", ",", "k_", ",", "d_", ",", "z0_"}], 
   "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"DE", "[", 
        RowBox[{
        "\[ImaginaryI]\[Omega]", ",", "k", ",", "zz", ",", "d", ",", "z0"}], 
        "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"a", "[", "\[Epsilon]", "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "[", "\[Epsilon]", "]"}], "/.", 
         RowBox[{"BCUV", "[", 
          RowBox[{"\[ImaginaryI]\[Omega]", ",", "k", ",", "d", ",", "z0"}], 
          "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "'"}], "[", "\[Epsilon]", "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "'"}], "[", "\[Epsilon]", "]"}], "/.", 
         RowBox[{"BCUV", "[", 
          RowBox[{"\[ImaginaryI]\[Omega]", ",", "k", ",", "d", ",", "z0"}], 
          "]"}]}], ")"}]}]}], "}"}], ",", "a", ",", 
    RowBox[{"{", 
     RowBox[{"zz", ",", "\[Epsilon]", ",", "zMid"}], "}"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SolIR", "[", 
   RowBox[{
   "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "a0_", ",", "d_", ",", "z0_"}], 
   "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"DE", "[", 
        RowBox[{
        "\[ImaginaryI]\[Omega]", ",", "k", ",", "zz", ",", "d", ",", "z0"}], 
        "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"a", "[", 
        RowBox[{"1", "-", "\[Epsilon]"}], "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "[", 
          RowBox[{"1", "-", "\[Epsilon]"}], "]"}], "/.", 
         RowBox[{"BCIR", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "d", ",", "z0"}],
           "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "'"}], "[", 
        RowBox[{"1", "-", "\[Epsilon]"}], "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "'"}], "[", 
          RowBox[{"1", "-", "\[Epsilon]"}], "]"}], "/.", 
         RowBox[{"BCIR", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "d", ",", "z0"}],
           "]"}]}], ")"}]}]}], "}"}], ",", "a", ",", 
    RowBox[{"{", 
     RowBox[{"zz", ",", 
      RowBox[{"1", "-", "\[Epsilon]"}], ",", "zMid"}], "}"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.941120089936151*^9, 3.941120111723753*^9}, {
   3.941120142193795*^9, 3.941120176062103*^9}, {3.941120247848224*^9, 
