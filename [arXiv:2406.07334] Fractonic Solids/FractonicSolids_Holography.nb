Cell["Match the solutions", "Text",
 CellChangeTimes->{{3.9412807709748497`*^9, 
  3.941280787992165*^9}},ExpressionUUID->"92bcac53-f388-4646-8363-\
fbd5ccbf87e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ImaginaryI]disp", "[", 
   RowBox[{"k_", ",", "d_", ",", "z0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "roots", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"roots", "=", 
      RowBox[{
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "d", ",", "z0"}], 
                "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "d", ",", 
                 "z0"}], "]"}]}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "d", ",", "z0"}], 
                "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "d", ",", 
                 "z0"}], "]"}]}], ")"}]}]}], "}"}], "//", "Evaluate"}], ",", 
         RowBox[{"{", 
          RowBox[{"a0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[ImaginaryI]\[Omega]", ",", "0"}], "}"}]}], "]"}], "//", 
       "Quiet"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[ImaginaryI]\[Omega]", ",", "a0"}], "}"}], "/.", 
      "roots"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9411228263758907`*^9, 3.941122887634691*^9}, {
  3.941124459300476*^9, 3.941124462408635*^9}, {3.941124503777883*^9, 
