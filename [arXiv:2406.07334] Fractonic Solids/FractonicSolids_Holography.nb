Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "10"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zMid", "=", 
   RowBox[{"1", "/", "2"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"SolUV", "[", 
   RowBox[{
   "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "bx_", ",", "d_", ",", "z0_", ",",
     "\[Lambda]_"}], "]"}], ":=", 
  RowBox[{"NDSolve", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"DE1", "[", 
        RowBox[{
        "\[ImaginaryI]\[Omega]", ",", "k", ",", "zz", ",", "d", ",", "z0", ",",
          "\[Lambda]"}], "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"DE2", "[", 
        RowBox[{
        "\[ImaginaryI]\[Omega]", ",", "k", ",", "zz", ",", "d", ",", "z0", ",",
          "\[Lambda]"}], "]"}], "==", "0"}], ",", 
      RowBox[{
       RowBox[{"a", "[", "\[Epsilon]", "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"a", "[", "\[Epsilon]", "]"}], "/.", 
         RowBox[{"BCUV", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", "z0", ",",
            "\[Lambda]"}], "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"a", "'"}], "[", "\[Epsilon]", "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"a", "'"}], "[", "\[Epsilon]", "]"}], "/.", 
         RowBox[{"BCUV", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", "z0", ",",
            "\[Lambda]"}], "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"b", "[", "\[Epsilon]", "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"b", "[", "\[Epsilon]", "]"}], "/.", 
         RowBox[{"BCUV", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", "z0", ",",
            "\[Lambda]"}], "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{
        RowBox[{"b", "'"}], "[", "\[Epsilon]", "]"}], "==", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"b", "'"}], "[", "\[Epsilon]", "]"}], "/.", 
         RowBox[{"BCUV", "[", 
          RowBox[{
          "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", "z0", ",",
            "\[Lambda]"}], "]"}]}], ")"}]}]}], "}"}], ",", 
