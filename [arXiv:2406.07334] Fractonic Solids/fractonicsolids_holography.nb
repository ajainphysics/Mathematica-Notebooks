 CellLabel->"In[8]:=",ExpressionUUID->"3cf0220c-56f6-4f1c-bad2-66ee26e0c727"],

Cell["Match the solutions in the middle", "Text",
 CellChangeTimes->{{3.9412807709748497`*^9, 3.941280787992165*^9}, {
  3.94180791968519*^9, 
  3.941807921096652*^9}},ExpressionUUID->"92bcac53-f388-4646-8363-\
fbd5ccbf87e7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ImaginaryI]disp", "[", 
   RowBox[{"k_", ",", "d_", ",", "z0_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "roots", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"roots", "=", 
      RowBox[{
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "d", ",", "z0"}], 
                "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "d", ",", 
                 "z0"}], "]"}]}], ")"}]}], ",", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "d", ",", "z0"}], 
                "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "d", ",", 
                 "z0"}], "]"}]}], ")"}]}]}], "}"}], "//", "Evaluate"}], ",", 
         RowBox[{"{", 
          RowBox[{"a0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[ImaginaryI]\[Omega]", ",", "0"}], "}"}]}], "]"}], "//", 
       "Quiet"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[ImaginaryI]\[Omega]", ",", "a0"}], "}"}], "/.", 
      "roots"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
 CellChangeTimes->{{3.9411228263758907`*^9, 3.941122887634691*^9}, {
  3.941124459300476*^9, 3.941124462408635*^9}, {3.941124503777883*^9, 
  3.94112453724549*^9}, {3.941124765594701*^9, 3.941124765697545*^9}, {
