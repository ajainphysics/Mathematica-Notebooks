Cell[TextData[{
 "The parametric form ",
 Cell[BoxData[
  FractionBox[
   RowBox[{"z0", "/", "\[Lambda]"}], 
   RowBox[{"d", "-", "1"}]]],
  CellChangeTimes->{{3.941280830422777*^9, 3.941280856799693*^9}, 
    3.941280937720481*^9, {3.9412809824238367`*^9, 3.941281033873171*^9}, {
    3.9412810888468857`*^9, 3.941281196324016*^9}, {3.941283359128004*^9, 
    3.941283368620248*^9}, {3.941283402434823*^9, 3.94128340522877*^9}, {
    3.941296854635663*^9, 3.941296857030188*^9}, 3.9412970809142847`*^9, 
    3.941297141212055*^9},ExpressionUUID->
  "95a21f00-45ce-497d-996a-96d3bb5c63f7"],
 " can be obtained by repeating this calculation for different values of \
parameters.\nThe data differs from the sub-diffusive ansatz at larger values \
of k due to higher-order corrections."
}], "Text",
 CellChangeTimes->{{3.941808529823662*^9, 
  3.9418085960472317`*^9}},ExpressionUUID->"46e969ed-6f4f-4f62-82c1-\
035aaafd0844"]
}, Open  ]],

