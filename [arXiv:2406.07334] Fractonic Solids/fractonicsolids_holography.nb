Cell[BoxData[
 RowBox[{
  RowBox[{"\[ImaginaryI]disp", "[", 
   RowBox[{"k_", ",", "d_", ",", "z0_", ",", "\[Lambda]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "roots", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"roots", "=", 
      RowBox[{
       RowBox[{"FindRoot", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"{", "\[IndentingNewLine]", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", 
                 "z0", ",", "\[Lambda]"}], "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"a", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "b0", ",", 
                 "d", ",", "z0", ",", "\[Lambda]"}], "]"}]}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", 
                 "z0", ",", "\[Lambda]"}], "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"a", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "b0", ",", 
                 "d", ",", "z0", ",", "\[Lambda]"}], "]"}]}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", 
                 "z0", ",", "\[Lambda]"}], "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"b", "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "b0", ",", 
                 "d", ",", "z0", ",", "\[Lambda]"}], "]"}]}], ")"}]}], ",", 
            "\[IndentingNewLine]", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"b", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolUV", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "bx", ",", "d", ",", 
                 "z0", ",", "\[Lambda]"}], "]"}]}], ")"}], "==", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"b", "'"}], "[", "0.5", "]"}], "/.", 
               RowBox[{"SolIR", "[", 
                RowBox[{
                "\[ImaginaryI]\[Omega]", ",", "k", ",", "a0", ",", "b0", ",", 
                 "d", ",", "z0", ",", "\[Lambda]"}], "]"}]}], ")"}]}]}], 
           "\[IndentingNewLine]", "}"}], "//", "Evaluate"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[ImaginaryI]\[Omega]", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"a0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"b0", ",", "1"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"bx", ",", "1"}], "}"}]}], "]"}], "//", "Quiet"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"\[ImaginaryI]\[Omega]", ",", "a0", ",", "b0", ",", "bx"}], 
       "}"}], "/.", "roots"}]}]}], "\[IndentingNewLine]", "]"}]}]], "Input",
