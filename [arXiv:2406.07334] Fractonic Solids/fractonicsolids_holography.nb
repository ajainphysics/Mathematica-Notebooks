Cell[CellGroupData[{

Cell["Crystal-dipole holography", "Chapter",
 CellChangeTimes->{{3.941195084067369*^9, 3.941195084356594*^9}, 
   3.941197673346103*^9, {3.941283416055477*^9, 3.941283418715371*^9}, {
   3.9418086165822268`*^9, 
   3.941808623391779*^9}},ExpressionUUID->"47b7b53c-92d2-464f-90e5-\
7dc33c045f79"],

Cell["\<\
Let us now consider the sub-diffusive QNM in crystal-dipole holography. We \
start with the differential equations\
\>", "Text",
 CellChangeTimes->{{3.94128072865935*^9, 3.941280734525185*^9}, {
  3.941282632010287*^9, 3.941282633366899*^9}, {3.941808077891473*^9, 
  3.941808104552806*^9}},ExpressionUUID->"12183cab-4b9c-4b4b-bcee-\
fdc9d2d73a62"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"fVal", "[", 
    RowBox[{"z_", ",", "d_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"1", "-", 
    FractionBox[
     SuperscriptBox["z", 
      RowBox[{"d", "+", "1"}]], 
     SuperscriptBox["z0", 
      RowBox[{"d", "+", "1"}]]]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DE1", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "z_", ",", "d_", ",", "z0_", ",",
      "\[Lambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["z", 
          RowBox[{"d", "-", "2"}]]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "z"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", 
            RowBox[{"d", "-", "2"}]], 
           RowBox[{"f", "[", 
            RowBox[{"z", ",", "d", ",", "z0"}], "]"}], 
           RowBox[{
            RowBox[{"a", "'"}], "[", "z", "]"}]}], ")"}]}]}], "+", 
       RowBox[{"\[ImaginaryI]\[Omega]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"a", "'"}], "[", "z", "]"}], "+", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["z", 
             RowBox[{"d", "-", "2"}]]], 
           RowBox[{
            SubscriptBox["\[PartialD]", "z"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["z", 
               RowBox[{"d", "-", "2"}]], 
              RowBox[{"a", "[", "z", "]"}]}], ")"}]}]}]}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["k", "2"], 
        RowBox[{"a", "[", "z", "]"}]}], "+", 
       RowBox[{"\[Lambda]", " ", 
        SuperscriptBox["k", "2"], 
        RowBox[{"b", "[", "z", "]"}]}]}], ")"}], "/.", 
     RowBox[{"f", "->", "fVal"}]}], "//", "Simplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"DE2", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "z_", ",", "d_", ",", "z0_", ",",
      "\[Lambda]_"}], "]"}], "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         SuperscriptBox["z", 
          RowBox[{"d", "-", "2"}]]], 
        RowBox[{
         SubscriptBox["\[PartialD]", "z"], 
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["z", 
            RowBox[{"d", "-", "2"}]], 
           RowBox[{"f", "[", 
            RowBox[{"z", ",", "d", ",", "z0"}], "]"}], 
           RowBox[{
            RowBox[{"b", "'"}], "[", "z", "]"}]}], ")"}]}]}], "+", 
       RowBox[{"\[ImaginaryI]\[Omega]", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"b", "'"}], "[", "z", "]"}], "+", 
          RowBox[{
           FractionBox["1", 
            SuperscriptBox["z", 
             RowBox[{"d", "-", "2"}]]], 
           RowBox[{
            SubscriptBox["\[PartialD]", "z"], 
            RowBox[{"(", 
             RowBox[{
              SuperscriptBox["z", 
               RowBox[{"d", "-", "2"}]], 
              RowBox[{"b", "[", "z", "]"}]}], ")"}]}]}]}], ")"}]}], "-", 
       RowBox[{
        SuperscriptBox["k", "2"], 
        RowBox[{"b", "[", "z", "]"}]}], "-", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"b", "[", "z", "]"}]}], "-", 
         RowBox[{"a", "[", "z", "]"}]}], ")"}]}], ")"}], "/.", 
     RowBox[{"f", "->", "fVal"}]}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.94119451207531*^9, 3.941194542346142*^9}, {
  3.941195009936081*^9, 3.941195135219234*^9}, {3.941195213430114*^9, 
  3.941195230343963*^9}, {3.94119542385813*^9, 3.94119543059512*^9}, {
  3.941195553694321*^9, 3.941195559035137*^9}, {3.941196389982085*^9, 
  3.941196397765764*^9}, {3.941197676100103*^9, 3.941197748141425*^9}, {
  3.941203798219146*^9, 3.94120397234036*^9}, {3.941204003662378*^9, 
  3.9412040055574617`*^9}, {3.941219044520977*^9, 3.941219052468608*^9}, {
  3.94121914521994*^9, 3.941219159560667*^9}, {3.941219203645443*^9, 
  3.941219212670998*^9}, {3.941219416460201*^9, 3.941219451067077*^9}, {
  3.941219638449388*^9, 3.9412196597601757`*^9}, {3.941219795216325*^9, 
  3.941219796953398*^9}, {3.941281256677703*^9, 3.94128133012192*^9}, {
  3.941281372318619*^9, 3.941281396211463*^9}, {3.941281439877982*^9, 
  3.9412814896462173`*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"021724ab-94a5-4add-90a7-5e7bfef3f114"],

Cell[TextData[{
 "We have redefined ",
 Cell[BoxData[
  RowBox[{"b", "->", " ", 
   RowBox[{"\[ImaginaryI]k", " ", "b"}]}]],
  CellChangeTimes->{{3.94119451207531*^9, 3.941194542346142*^9}, {
   3.941195009936081*^9, 3.941195135219234*^9}, {3.941195213430114*^9, 
   3.941195230343963*^9}, {3.94119542385813*^9, 3.94119543059512*^9}, {
   3.941195553694321*^9, 3.941195559035137*^9}, {3.941196389982085*^9, 
   3.941196397765764*^9}, {3.941197676100103*^9, 3.941197748141425*^9}, {
   3.941203798219146*^9, 3.94120397234036*^9}, {3.941204003662378*^9, 
   3.9412040055574617`*^9}, {3.941219044520977*^9, 3.941219052468608*^9}, {
   3.94121914521994*^9, 3.941219159560667*^9}, {3.941219203645443*^9, 
   3.941219212670998*^9}, {3.941219416460201*^9, 3.941219451067077*^9}, {
   3.941219638449388*^9, 3.9412196597601757`*^9}, {3.941219795216325*^9, 
   3.941219796953398*^9}, {3.941281256677703*^9, 3.94128133012192*^9}, {
   3.941281372318619*^9, 3.941281396211463*^9}, {3.941281439877982*^9, 
   3.9412814896462173`*^9}},ExpressionUUID->
  "4b94c2fe-88ab-4277-9eb7-cff452337f00"],
 " compared to the main text to keep the differential equations real."
}], "Text",
 CellChangeTimes->{{3.941808146873074*^9, 
  3.941808227316687*^9}},ExpressionUUID->"186292b4-8773-467a-b5eb-\
e0f35738de7f"],

Cell["Perform asymptotic expansions", "Text",
 CellChangeTimes->{{3.9412807421611567`*^9, 3.941280748256846*^9}, 
   3.941807913042417*^9},ExpressionUUID->"f0a613c3-cae9-440e-96b7-\
aa384f7eb0f2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"expansion", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aAnsUV", "[", "z_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aUV", "[", "n", "]"}], 
      SuperscriptBox["z", "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bAnsUV", "[", "z_", "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bUV", "[", "n", "]"}], 
      SuperscriptBox["z", "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"aAnsIR", "[", 
    RowBox[{"z_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"aIR", "[", "n", "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z0", "-", "z"}], ")"}], "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"bAnsIR", "[", 
    RowBox[{"z_", ",", "z0_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"bIR", "[", "n", "]"}], 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"z0", "-", "z"}], ")"}], "n"]}], ",", 
     RowBox[{"{", 
      RowBox[{"n", ",", "0", ",", "expansion"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCUV", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "bx_", ",", "d_", ",", "z0_", ",",
      "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"z", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"DE1", "[", 
            RowBox[{
            "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0", 
             ",", "\[Lambda]"}], "]"}], ",", 
           RowBox[{"DE2", "[", 
            RowBox[{
            "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0", 
             ",", "\[Lambda]"}], "]"}]}], "}"}]}], "/.", 
        RowBox[{"a", "->", "aAnsUV"}]}], "/.", 
       RowBox[{"b", "->", "bAnsUV"}]}], "//", 
      RowBox[{
       RowBox[{"#", "+", 
        SuperscriptBox[
         RowBox[{"O", "[", "z", "]"}], "expansion"]}], "&"}]}], "//", 
     RowBox[{
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{"#", "==", 
         RowBox[{"{", 
          RowBox[{"0", ",", "0"}], "}"}]}], ",", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"aUV", "[", "n", "]"}], ",", 
             RowBox[{"bUV", "[", "n", "]"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"n", ",", "1", ",", "expansion"}], "}"}]}], "]"}], "//", 
         "Flatten"}]}], "]"}], "&"}]}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"aAnsUV", "[", "z", "]"}], "//", "Evaluate"}]}], 
            "]"}]}], ",", 
          RowBox[{"b", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"bAnsUV", "[", "z", "]"}], "//", "Evaluate"}]}], 
            "]"}]}]}], "}"}], "/.", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "/.", 
       RowBox[{
        RowBox[{"aUV", "[", "0", "]"}], "->", "1"}]}], "/.", 
      RowBox[{
       RowBox[{"bUV", "[", "0", "]"}], "->", "bx"}]}], "&"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"BCIR", "[", 
    RowBox[{
    "\[ImaginaryI]\[Omega]_", ",", "k_", ",", "a0_", ",", "b0_", ",", "d_", ",",
      "z0_", ",", "\[Lambda]_"}], "]"}], ":=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"DE1", "[", 
             RowBox[{
             "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0",
               ",", "\[Lambda]"}], "]"}], ",", 
            RowBox[{"DE2", "[", 
             RowBox[{
             "\[ImaginaryI]\[Omega]", ",", "k", ",", "z", ",", "d", ",", "z0",
               ",", "\[Lambda]"}], "]"}]}], "}"}], "/.", 
          RowBox[{"a", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{"aAnsIR", "[", 
              RowBox[{"z", ",", "z0"}], "]"}]}], "]"}]}]}], "/.", 
         RowBox[{"b", "->", 
          RowBox[{"Function", "[", 
           RowBox[{"z", ",", 
            RowBox[{"bAnsIR", "[", 
             RowBox[{"z", ",", "z0"}], "]"}]}], "]"}]}]}], "/.", 
        RowBox[{"z", "->", 
         RowBox[{"z0", "-", "\[Delta]z"}]}]}], "//", 
       RowBox[{
        RowBox[{"#", "+", 
         SuperscriptBox[
          RowBox[{"O", "[", "\[Delta]z", "]"}], "expansion"]}], "&"}]}], "//", 
      RowBox[{
       RowBox[{"Solve", "[", 
        RowBox[{
         RowBox[{"#", "==", 
          RowBox[{"{", 
           RowBox[{"0", ",", "0"}], "}"}]}], ",", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"aIR", "[", "n", "]"}], ",", 
              RowBox[{"bIR", "[", "n", "]"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"n", ",", "1", ",", "expansion"}], "}"}]}], "]"}], "//", 
          "Flatten"}]}], "]"}], "&"}]}], "//", "Simplify"}], "//", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"a", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"aAnsIR", "[", 
               RowBox[{"z", ",", "z0"}], "]"}], "//", "Evaluate"}]}], "]"}]}],
           ",", 
          RowBox[{"b", "->", 
           RowBox[{"Function", "[", 
            RowBox[{"z", ",", 
             RowBox[{
              RowBox[{"bAnsIR", "[", 
               RowBox[{"z", ",", "z0"}], "]"}], "//", "Evaluate"}]}], 
            "]"}]}]}], "}"}], "/.", 
        RowBox[{"#", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}]}],
        "/.", 
       RowBox[{
        RowBox[{"aIR", "[", "0", "]"}], "->", "a0"}]}], "/.", 
      RowBox[{
       RowBox[{"bIR", "[", "0", "]"}], "->", "b0"}]}], "&"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.941197766534936*^9, 3.941197782876367*^9}, {
   3.941197823503355*^9, 3.941197886467741*^9}, {3.941197931899485*^9, 
   3.94119793220431*^9}, 3.941198133263688*^9, {3.941198167621113*^9, 
   3.941198339231649*^9}, {3.9411983694836197`*^9, 3.941198398892955*^9}, {
   3.941198866705759*^9, 3.941198902025858*^9}, 3.941199262754994*^9, 
   3.941199341773526*^9, {3.941199633649605*^9, 3.941199641823968*^9}, {
   3.941204010989293*^9, 3.941204017681391*^9}, {3.941204053482757*^9, 
   3.941204053761302*^9}, {3.941278642394052*^9, 3.941278642970147*^9}, 
   3.941281510275764*^9, {3.941281553815138*^9, 3.941281614387115*^9}, {
   3.94128164894343*^9, 3.9412817943587713`*^9}},
 CellLabel->"In[25]:=",ExpressionUUID->"8955af7f-b07b-4f48-b1c9-91de7a73ad06"],

Cell["\<\
Find numerical solutions shooting from the boundary and the horizon\
\>", "Text",
 CellChangeTimes->{{3.941280754884863*^9, 3.9412807835151253`*^9}, 
   3.941807906343457*^9},ExpressionUUID->"eb692cea-33fc-429e-afb0-\
b9cf83c1082e"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Epsilon]", "=", 
   SuperscriptBox["10", 
    RowBox[{"-", "5"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"zMid", "=", 
