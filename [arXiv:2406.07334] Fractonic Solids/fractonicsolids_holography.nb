Cell[BoxData[{
 RowBox[{
  RowBox[{"k", "=", "0.2"}], ";", 
  RowBox[{"d", "=", "3"}], ";", 
  RowBox[{"z0", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\[ImaginaryI]\[Omega]", ",", "a0"}], "}"}], "=", 
