      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Delta]\[CurlyPhi]I", "[", "II", "]"}], "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
