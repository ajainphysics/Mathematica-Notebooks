Cell[BoxData[{
 RowBox[{
  RowBox[{"T\[Mu]\[Nu]swave", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"T\[Mu]\[Nu]hsswave", "+", "T\[Mu]\[Nu]diss", "+", 
       SuperscriptBox[
        RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], "/.", "sReplace"}], "/.", 
     RowBox[{"back", "->", "0"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J\[Mu]swave", "=", 
   RowBox[{
