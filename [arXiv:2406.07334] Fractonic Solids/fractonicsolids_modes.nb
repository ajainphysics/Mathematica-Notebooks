Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalGamma]", "=", 
   FractionBox[
    RowBox[{" ", 
     RowBox[{"(", 
      RowBox[{"\[Sigma]", "+", 
       RowBox[{
        SuperscriptBox["n0", "2"], "/", "\[Sigma]\[Phi]"}]}], ")"}]}], 
    "\[Chi]d"]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"det\[Chi]", "=", 
   RowBox[{
    RowBox[{"\[Chi]nn", " ", "\[Chi]ss"}], "-", 
    SuperscriptBox["\[Chi]sn", "2"]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vparr", "=", 
   SqrtBox[
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["s0", "2"], " ", "\[Chi]nn"}], "-", 
       RowBox[{"2", " ", "n0", " ", "s0", " ", "\[Chi]sn"}], "+", 
       RowBox[{
        SuperscriptBox["n0", "2"], " ", "\[Chi]ss"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s0", " ", "T0"}], "+", 
         RowBox[{"n0", " ", "\[Mu]0"}]}], ")"}], " ", "det\[Chi]"}]], "+", 
     FractionBox[
      RowBox[{"B", "+", 
       RowBox[{"2", 
        FractionBox[
         RowBox[{"d", "-", "1"}], "d"], " ", "G"}]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s0", " ", "T0"}], "+", 
        RowBox[{"n0", " ", "\[Mu]0"}]}], ")"}]]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vperp", "=", 
   SqrtBox[
    FractionBox["G", 
     RowBox[{
      RowBox[{"s0", " ", "T0"}], "+", 
      RowBox[{"n0", " ", "\[Mu]0"}]}]]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Dn", "=", 
   FractionBox["\[Sigma]", "\[Chi]nn"]}], " ", ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"D\[Phi]", "=", 
   RowBox[{
    FractionBox["1", 
     RowBox[{"\[Sigma]\[Phi]", "+", 
      RowBox[{
       SuperscriptBox["n0", "2"], "/", "\[Sigma]"}]}]], 
    FractionBox[
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s0", " ", "T0"}], "+", 
        RowBox[{"n0", " ", "\[Mu]0"}]}], ")"}], 
      RowBox[{"(", 
       RowBox[{
        SuperscriptBox["n0", "2"], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"B", "+", 
           RowBox[{"2", 
            FractionBox[
             RowBox[{"d", "-", "1"}], "d"], "G"}]}], ")"}], " ", 
         "\[Chi]nn"}]}], ")"}]}], 
     RowBox[{
      SuperscriptBox["T0", "2"], " ", "det\[Chi]", " ", 
      SuperscriptBox["vparr", "2"]}]]}]}], " ", ";"}]}], "Input",
