Cell["\<\
This phase needs a bit more work, because we need to convert the vector \
Goldstone dynamics to scalar Goldstone\
\>", "Text",
 CellChangeTimes->{{3.925888661718597*^9, 3.925888669778199*^9}, {
   3.925889233008025*^9, 3.925889240015197*^9}, 
   3.9258893750794907`*^9},ExpressionUUID->"f6472c65-66ed-42df-8fe1-\
48293f4c0332"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sReplace", "=", 
   RowBox[{"Table", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Delta]\[CurlyPhi]I", "[", "II", "]"}], "->", 
      RowBox[{"Function", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", 
        RowBox[{
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              FractionBox["1", "\[Epsilon]"], "\[CurlyPhi]Is"}], "+", 
             SuperscriptBox[
              RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], ")"}], 
           "\[LeftDoubleBracket]", "II", "\[RightDoubleBracket]"}], "//", 
          "Normal"}], "//", "Evaluate"}]}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"II", ",", "1", ",", "d"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.925889243522017*^9, 3.925889293389461*^9}, {
  3.92588934259479*^9, 3.925889370904566*^9}, {3.925890799434948*^9, 
  3.9258908088283453`*^9}, {3.925890845742261*^9, 3.925890848972208*^9}},
 CellLabel->
  "In[107]:=",ExpressionUUID->"357ff6fe-553f-4693-9ad9-f02323964e5a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"\[ScriptCapitalF]swave", "=", 
   RowBox[{"\[ScriptCapitalF]", "/.", "sReplace"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.925890785352634*^9, 3.925890789760185*^9}, {
  3.925890852957188*^9, 3.925890881240952*^9}},
 CellLabel->
  "In[108]:=",ExpressionUUID->"27b4d2e8-98ed-418d-bf76-022999da8ef4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"T\[Mu]\[Nu]hsswave", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "sqdetg"], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["2", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"ii", ",", "jj"}], "]"}]], 
         RowBox[{"\[Epsilon]", " ", "back"}]], 
        RowBox[{"VariationalD", "[", 
         RowBox[{"\[ScriptCapitalF]swave", ",", 
          RowBox[{
           RowBox[{"\[Delta]g", "[", 
            RowBox[{"ii", ",", "jj"}], "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", 
         RowBox[{"d", "+", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", 
         RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}]}], "+", 
    SuperscriptBox[
     RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J\[Mu]hsswave", "=", 
   RowBox[{
    FractionBox["1", "sqdetg"], 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"\[Epsilon]", " ", "back"}]], 
       RowBox[{"VariationalD", "[", 
        RowBox[{"\[ScriptCapitalF]swave", ",", 
         RowBox[{
          RowBox[{"\[Delta]A", "[", "ii", "]"}], "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
      
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JI\[Mu]hsswave", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "sqdetg"], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[Epsilon]", " ", "back"}]], 
        RowBox[{"VariationalD", "[", 
         RowBox[{"\[ScriptCapitalF]swave", ",", 
          RowBox[{
           RowBox[{"\[Delta]AI", "[", 
            RowBox[{"II", ",", "ii"}], "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"II", ",", "1", ",", "d"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", 
         RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}]}], "-", 
    RowBox[{"\[Phi]I", "\[TensorProduct]", "J\[Mu]hsswave"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K\[CurlyPhi]hsswave", "=", 
   RowBox[{
    FractionBox["1", "sqdetg"], 
    FractionBox["1", "\[Epsilon]"], 
    RowBox[{"VariationalD", "[", 
     RowBox[{"\[ScriptCapitalF]swave", ",", 
      RowBox[{"\[Delta]\[CurlyPhi]", "[", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KIhsswave", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "sqdetg"], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", "\[Epsilon]"], 
        RowBox[{"VariationalD", "[", 
         RowBox[{"\[ScriptCapitalF]swave", ",", 
          RowBox[{
           RowBox[{"\[Delta]\[Phi]I", "[", "II", "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"II", ",", "1", ",", "d"}], "}"}]}], "]"}]}], "+", 
    RowBox[{"\[CurlyPhi]Is", " ", "K\[CurlyPhi]hsswave"}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.925218550004506*^9, 3.925218561456306*^9}, {
   3.925218622211065*^9, 3.925218636929158*^9}, {3.925268046185394*^9, 
