      RowBox[{"O", "[", "k", "]"}], "18"]}], "&"}]}], "//", 
  "Simplify"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalDelta]", "/.", 
