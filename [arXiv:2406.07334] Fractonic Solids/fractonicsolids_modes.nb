            RowBox[{
             RowBox[{"t\[Delta]\[Beta]", "[", "ii", "]"}], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}], 
               "+", 
               RowBox[{"\[ImaginaryI]", " ", "k", " ", "x"}]}]]}], "//", 
            "Evaluate"}]}], "]"}]}], ",", 
        RowBox[{"{", 
