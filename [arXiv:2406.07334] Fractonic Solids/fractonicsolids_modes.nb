 RowBox[{
  RowBox[{"modeBasis", "=", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Delta]\[Beta]", "[", "ii", "]"}], "->", 
