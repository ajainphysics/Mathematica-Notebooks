                "2"], " ", "\[Chi]nn"}]}], ")"}]}]]}], 
         RowBox[{
         "6", " ", "\[Sigma]", " ", "\[Sigma]\[CurlyPhi]", " ", "\[Chi]nn"}]],
         " ", ")"}], 
       SuperscriptBox["k", "2"]}]}]}], "/.", "simp"}], "//", 
   RowBox[{
    RowBox[{"#", "+", 
