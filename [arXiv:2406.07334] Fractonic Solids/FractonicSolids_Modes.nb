Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalGamma]", "=", 
   FractionBox[
    RowBox[{" ", 
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["n0", "2"], "+", 
       RowBox[{"\[Sigma]", " ", "\[Sigma]\[Phi]"}]}], ")"}]}], 
    RowBox[{"\[Sigma]\[Phi]", " ", "\[Chi]Inn"}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"det\[Chi]", "=", 
   RowBox[{
    RowBox[{"\[Chi]nn", " ", "\[Chi]ss"}], "-", 
