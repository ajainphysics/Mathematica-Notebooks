Notebook[{
Cell["\<\
This is a supplementary Mathematica notebook for the paper \
\[OpenCurlyDoubleQuote]Fractonic solids\[CloseCurlyDoubleQuote] available at \
https://arxiv.org/abs/2406.07334.
Here we compute the mode spectrum of various phases of \
crystal-dipole-invariant relativistic hydrodynamics.\
\>", "Text",
 CellChangeTimes->{{3.927104609954709*^9, 3.927104639745693*^9}, {
  3.9271051545088882`*^9, 3.927105194460044*^9}, {3.9271053267201233`*^9, 
