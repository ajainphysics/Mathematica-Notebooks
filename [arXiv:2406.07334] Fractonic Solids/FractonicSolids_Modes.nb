Cell[BoxData[{
 RowBox[{
  RowBox[{"T\[Mu]\[Nu]swave", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"T\[Mu]\[Nu]hsswave", "+", "T\[Mu]\[Nu]diss", "+", 
       SuperscriptBox[
        RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], "/.", "sReplace"}], "/.", 
     RowBox[{"back", "->", "0"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J\[Mu]swave", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"J\[Mu]hsswave", "+", "J\[Mu]diss", "+", 
       SuperscriptBox[
        RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], "/.", "sReplace"}], "/.", 
     RowBox[{"back", "->", "0"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JI\[Mu]swave", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"JI\[Mu]hsswave", "+", "JI\[Mu]diss", "+", 
       SuperscriptBox[
        RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], "/.", "sReplace"}], "/.", 
     RowBox[{"back", "->", "0"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KIswave", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"KIhsswave", "+", "KIdiss", "+", 
       SuperscriptBox[
        RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], "/.", "sReplace"}], "/.", 
     RowBox[{"back", "->", "0"}]}], "//", "Simplify"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K\[CurlyPhi]swave", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"K\[CurlyPhi]hsswave", "-", 
       RowBox[{"\[Sigma]\[CurlyPhi]", " ", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"u", ".", "\[Xi]"}], "-", 
            RowBox[{"u", ".", "eI", ".", 
             RowBox[{"Inverse", "[", "hIJ", "]"}], ".", 
             RowBox[{"eI", "\[Transpose]"}], ".", "inverse", ".", "\[Xi]"}]}],
            ")"}], "-", "\[Mu]"}], ")"}]}], "+", 
       SuperscriptBox[
        RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}], "/.", "sReplace"}], "/.", 
     RowBox[{"back", "->", "0"}]}], "//", "Simplify"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.925889407628542*^9, 3.925889413833058*^9}, 
