Cell[BoxData[
 RowBox[{
  RowBox[{"modeBasis", "=", 
   RowBox[{
    RowBox[{"{", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"\[Delta]\[Beta]", "[", "ii", "]"}], "->", 
         RowBox[{"Function", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}], ",", 
           RowBox[{
            RowBox[{
             RowBox[{"t\[Delta]\[Beta]", "[", "ii", "]"}], " ", 
             SuperscriptBox["\[ExponentialE]", 
              RowBox[{
               RowBox[{
                RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}], 
               "+", 
               RowBox[{"\[ImaginaryI]", " ", "k", " ", "x"}]}]]}], "//", 
            "Evaluate"}]}], "]"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "1", ",", 
          RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}], ",", 
      "\[IndentingNewLine]", 
