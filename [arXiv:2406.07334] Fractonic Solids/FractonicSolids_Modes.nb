        SuperscriptBox["n0", "2"], "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"B", "+", 
           RowBox[{"2", 
            FractionBox[
             RowBox[{"d", "-", "1"}], "d"], "G"}]}], ")"}], " ", 
         "\[Chi]nn"}]}], ")"}]}], 
     RowBox[{
      SuperscriptBox["T0", "2"], " ", "det\[Chi]", " ", 
      SuperscriptBox["vparr", "2"]}]]}]}], " ", ";"}]}], "Input",
