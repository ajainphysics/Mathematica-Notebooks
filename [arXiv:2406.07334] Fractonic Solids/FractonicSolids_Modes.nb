 RowBox[{
  RowBox[{"vparr", "=", 
   SqrtBox[
    RowBox[{
     FractionBox[
      RowBox[{
       RowBox[{
        SuperscriptBox["s0", "2"], " ", "\[Chi]nn"}], "-", 
       RowBox[{"2", " ", "n0", " ", "s0", " ", "\[Chi]sn"}], "+", 
       RowBox[{
        SuperscriptBox["n0", "2"], " ", "\[Chi]ss"}]}], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"s0", " ", "T0"}], "+", 
         RowBox[{"n0", " ", "\[Mu]0"}]}], ")"}], " ", "det\[Chi]"}]], "+", 
     FractionBox[
      RowBox[{"B", "+", 
       RowBox[{"2", 
        FractionBox[
         RowBox[{"d", "-", "1"}], "d"], " ", "G"}]}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"s0", " ", "T0"}], "+", 
        RowBox[{"n0", " ", "\[Mu]0"}]}], ")"}]]}]]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"vperp", "=", 
