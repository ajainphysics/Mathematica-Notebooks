Cell[BoxData[{
 RowBox[{
  RowBox[{"EE1s", "=", 
   RowBox[{"KIswave", "/.", 
    RowBox[{"back", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EE2s", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"inverse", ".", 
        RowBox[{"covariant", "[", 
         RowBox[{"metric", ".", "T\[Mu]\[Nu]swave", ".", "metric"}], "]"}]}], 
       ",", "Plus", ",", "2"}], "]"}], "-", 
     RowBox[{"tF", ".", "J\[Mu]swave"}], "-", 
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"FI", "\[LeftDoubleBracket]", "II", "\[RightDoubleBracket]"}],
         ".", 
        RowBox[{
        "JI\[Mu]swave", "\[LeftDoubleBracket]", "II", 
         "\[RightDoubleBracket]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"II", ",", "1", ",", "d"}], "}"}]}], "]"}]}], "/.", 
    RowBox[{"back", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EE3s", "=", 
   RowBox[{
    RowBox[{"Tr", "[", 
     RowBox[{"inverse", ".", 
      RowBox[{"covariant", "[", 
       RowBox[{"metric", ".", "J\[Mu]swave"}], "]"}]}], "]"}], "/.", 
    RowBox[{"back", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EE4s", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Tr", "[", 
        RowBox[{"inverse", ".", 
         RowBox[{"covariant", "[", 
          RowBox[{"metric", ".", 
           RowBox[{
           "JI\[Mu]swave", "\[LeftDoubleBracket]", "II", 
            "\[RightDoubleBracket]"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"II", ",", "1", ",", "d"}], "}"}]}], "]"}], "+", 
     RowBox[{"J\[Mu]swave", ".", "eI"}]}], "/.", 
    RowBox[{"back", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EE5s", "=", 
   RowBox[{"K\[CurlyPhi]swave", "/.", 
    RowBox[{"back", "->", "0"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"EEs", "=", 
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[Epsilon]", " ", 
          SuperscriptBox["\[ExponentialE]", 
           RowBox[{
            RowBox[{
             RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Omega]", " ", "t"}], "+", 
            RowBox[{"\[ImaginaryI]", " ", "k", " ", "x"}]}]]}]], 
        RowBox[{"{", 
         RowBox[{"EE1s", ",", "EE2s", ",", "EE3s", ",", "EE4s", ",", "EE5s"}],
          "}"}]}], "/.", "modeBasis"}], "//", "Flatten"}], "//", "Simplify"}],
     "//", "Normal"}]}], ";"}]}], "Input",
