Cell[BoxData[{
 RowBox[{
  RowBox[{"T\[Mu]\[Nu]diss", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"-", "\[Eta]"}], " ", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"inverse", "+", 
        RowBox[{"u", "\[TensorProduct]", "u"}]}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"covariant", "[", 
         RowBox[{"metric", ".", "u"}], "]"}], "//", 
        RowBox[{
         RowBox[{"#", "+", 
          RowBox[{"#", "\[Transpose]"}]}], "&"}]}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"inverse", "+", 
        RowBox[{"u", "\[TensorProduct]", "u"}]}], ")"}]}]}], "-", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"\[Zeta]", "-", 
       RowBox[{
        FractionBox["2", "d"], "\[Eta]"}]}], ")"}], 
     RowBox[{"(", 
      RowBox[{"inverse", "+", 
       RowBox[{"u", "\[TensorProduct]", "u"}]}], ")"}], 
     RowBox[{"Tr", "[", 
      RowBox[{
       RowBox[{"covariant", "[", 
        RowBox[{"metric", ".", "u"}], "]"}], ".", "inverse"}], "]"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J\[Mu]diss", "=", 
   RowBox[{
    RowBox[{"-", "\[Sigma]"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"T", " ", 
        RowBox[{"partial", "[", 
         FractionBox["\[Mu]", "T"], "]"}]}], "-", 
       RowBox[{"eI", ".", "\[Mu]I"}], "-", 
       RowBox[{"tF", ".", "u"}]}], ")"}], ".", 
     RowBox[{"(", 
      RowBox[{"inverse", "+", 
       RowBox[{"u", "\[TensorProduct]", "u"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JI\[Mu]diss", "=", 
   RowBox[{
    RowBox[{"-", "\[Sigma]I"}], 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"T", " ", 
        RowBox[{
         RowBox[{"partial", "[", 
          FractionBox["\[Mu]I", "T"], "]"}], "\[Transpose]"}]}], "-", 
       RowBox[{"FI", ".", "u"}]}], ")"}], ".", 
     RowBox[{"(", 
      RowBox[{"inverse", "+", 
       RowBox[{"u", "\[TensorProduct]", "u"}]}], ")"}]}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"KIdiss", "=", 
   RowBox[{
    RowBox[{"-", "\[Sigma]\[Phi]"}], " ", 
    RowBox[{"u", ".", "eI", ".", 
     RowBox[{"Inverse", "[", "hIJ", "]"}]}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K\[CurlyPhi]Idiss", "=", 
   RowBox[{
    RowBox[{"-", "\[Sigma]\[CurlyPhi]"}], " ", 
    RowBox[{"hIJ", ".", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"\[Xi]I", ".", "u"}], "-", "\[Mu]I"}], ")"}]}]}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.925296309949517*^9, 3.92529639261046*^9}, {
  3.925298581701959*^9, 3.925298604938843*^9}, {3.925298644031348*^9, 
