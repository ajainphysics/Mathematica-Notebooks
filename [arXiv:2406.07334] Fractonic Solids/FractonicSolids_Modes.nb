Cell[BoxData[{
 RowBox[{
  RowBox[{"T\[Mu]\[Nu]hsswave", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "sqdetg"], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox[
         SuperscriptBox["2", 
          RowBox[{"KroneckerDelta", "[", 
           RowBox[{"ii", ",", "jj"}], "]"}]], 
         RowBox[{"\[Epsilon]", " ", "back"}]], 
        RowBox[{"VariationalD", "[", 
         RowBox[{"\[ScriptCapitalF]swave", ",", 
          RowBox[{
           RowBox[{"\[Delta]g", "[", 
            RowBox[{"ii", ",", "jj"}], "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", 
         RowBox[{"d", "+", "1"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"jj", ",", "1", ",", 
         RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}]}], "+", 
    SuperscriptBox[
     RowBox[{"O", "[", "\[Epsilon]", "]"}], "2"]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"J\[Mu]hsswave", "=", 
   RowBox[{
    FractionBox["1", "sqdetg"], 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       FractionBox["1", 
        RowBox[{"\[Epsilon]", " ", "back"}]], 
       RowBox[{"VariationalD", "[", 
        RowBox[{"\[ScriptCapitalF]swave", ",", 
         RowBox[{
          RowBox[{"\[Delta]A", "[", "ii", "]"}], "[", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
      
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"JI\[Mu]hsswave", "=", 
   RowBox[{
    RowBox[{
     FractionBox["1", "sqdetg"], 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        FractionBox["1", 
         RowBox[{"\[Epsilon]", " ", "back"}]], 
        RowBox[{"VariationalD", "[", 
