          RowBox[{
           RowBox[{"\[Delta]AI", "[", 
            RowBox[{"II", ",", "ii"}], "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"II", ",", "1", ",", "d"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"ii", ",", "1", ",", 
         RowBox[{"d", "+", "1"}]}], "}"}]}], "]"}]}], "-", 
    RowBox[{"\[Phi]I", "\[TensorProduct]", "J\[Mu]hsswave"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"K\[CurlyPhi]hsswave", "=", 
   RowBox[{
    FractionBox["1", "sqdetg"], 
    FractionBox["1", "\[Epsilon]"], 
    RowBox[{"VariationalD", "[", 
     RowBox[{"\[ScriptCapitalF]swave", ",", 
