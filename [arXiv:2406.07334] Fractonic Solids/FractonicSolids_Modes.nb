      RowBox[{
       RowBox[{
        FractionBox["1", "\[Epsilon]"], 
        RowBox[{"VariationalD", "[", 
         RowBox[{"\[ScriptCapitalF]swave", ",", 
          RowBox[{
           RowBox[{"\[Delta]\[Phi]I", "[", "II", "]"}], "[", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "x", ",", "y", ",", "z"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"II", ",", "1", ",", "d"}], "}"}]}], "]"}]}], "+", 
    RowBox[{"\[CurlyPhi]Is", " ", "K\[CurlyPhi]hsswave"}]}]}], 
